# Instagram 自動投稿 — 環境変数サンプル
# ローカル実行時は `cp config.example.env .env` して値を設定(.env は Git にコミットしない)。
# GitHub Actions では下記を「Repository secrets」に登録する。

# Instagram プロアカウント(ビジネス/クリエイター)の user id(数値)
IG_USER_ID=

# 長期アクセストークン(instagram_content_publish 権限つき)
IG_ACCESS_TOKEN=

# 画像の公開URLベース(省略可)。未設定なら GitHub raw から自動生成:
#   https://raw.githubusercontent.com/<owner>/<repo>/<branch>/instagram/queue
# IG_IMAGE_BASE_URL=
