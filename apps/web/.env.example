# DigiLab Beauty LP — 環境変数テンプレート
# このファイルをコピーして `.env.local` を作成し、各URLを設定してください。
# （.env.local はGitにコミットされませんがクライアントへはNEXT_PUBLIC_のみ露出します）

# 公式LINE 友だち追加URL（例: https://line.me/R/ti/p/@xxxxxxx）
NEXT_PUBLIC_LINE_URL=

# Instagram プロフィールURL（例: https://www.instagram.com/xxxxxxx/）
NEXT_PUBLIC_INSTAGRAM_URL=

# Stripe Checkout（月額サブスク JPY1,000）URL ※決済は最終フェーズで実装
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=

# 企業向け 資料請求・問い合わせURL（フォーム等）
NEXT_PUBLIC_BUSINESS_CONTACT_URL=
