# DigiLab Beauty 環境変数テンプレート
# 使い方: このファイルを .env としてコピーし、各値を設定してください。
#   cp .env.example .env
# .env は .gitignore で除外されており、Gitにコミットされません。

# --- NewsAPI（日次ニュース収集: daily_news_collection.py / main.py）---
NEWSAPI_KEY=your_newsapi_key_here

# --- データベースパス（未設定なら各スクリプトの既定値を使用）---
DB_PATH=db/digilab_beauty.db

# --- メール送信（一括メール手順: bulk_email_procedure 関連）---
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_FROM=your_email@example.com
EMAIL_PASSWORD=your_email_app_password_here

# --- SerpAPI（検索系: 利用する場合）---
SERPAPI_KEY=your_serpapi_key_here

# --- Anthropic Claude API（任意: ai_assessment.py のClaude講評を使う場合のみ）---
# 未設定でも診断ツールはルールベースで動作します。
ANTHROPIC_API_KEY=your_anthropic_api_key_here
